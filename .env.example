# Website Configuration
PORT=3000
# Used when generating share links. Set this to your public domain in production.
APP_URL=http://localhost:3000

# Database Configuration
POSTGRES_USER=enduro
POSTGRES_PASSWORD=endurodev
POSTGRES_DB=endurolab
POSTGRES_PORT=5432
DATABASE_URL=postgresql://enduro:endurodev@localhost:5432/endurolab

# Encrypts Garmin OAuth tokens at rest. Generate a unique value with:
# openssl rand -base64 48
GARMIN_TOKEN_ENCRYPTION_KEY=

# Authenticates the internal durable Garmin job worker endpoint.
# Generate a unique value with: openssl rand -hex 32
GARMIN_WORKER_SECRET=

# In Docker, the app service overrides DATABASE_URL to use the db hostname:
# postgresql://enduro:endurodev@db:5432/endurolab
